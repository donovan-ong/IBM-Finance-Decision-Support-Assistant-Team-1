{
  "openapi": "3.0.1",
  "info": {
    "title": "Supabase Financial Records API",
    "version": "2.0.2",
    "description": "API connection to query financial_data_2025, financial_data_2026, categories, market_context, and business_rules tables with physical spreadsheet traceability metadata."
  },
  "servers": [
    {
      "url": "https://example.supabase.co/rest/v1"
    }
  ],
  "security": [
    {
      "SupabaseApiKey": []
    }
  ],
  "paths": {
    "/financial_data_2026": {
      "get": {
        "summary": "Fetch 2026 financial records by Period or Category with spreadsheet source metadata",
        "operationId": "get2026Records",
        "parameters": [
          {
            "name": "Period",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by period e.g. eq.2026-03 or in.(2026-01,2026-02,2026-03)"
          },
          {
            "name": "Category",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by category e.g. eq.Revenue or eq.Rent Expense"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval including source_file, source_row, and source_column coordinates",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    },
    "/financial_data_2025": {
      "get": {
        "summary": "Fetch 2025 financial records by Period or Category with spreadsheet source metadata",
        "operationId": "get2025Records",
        "parameters": [
          {
            "name": "Period",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by period e.g. eq.2025-03 or in.(2025-01,2025-02,2025-03)"
          },
          {
            "name": "Category",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by category e.g. eq.Revenue or eq.Rent Expense"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval including source_file, source_row, and source_column coordinates",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Fetch category metadata and display order",
        "operationId": "getCategories",
        "parameters": [
          {
            "name": "category_name",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by category name e.g. eq.Payroll Expense"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    },
    "/market_context": {
      "get": {
        "summary": "Fetch external economic indicators for explanation steps (POL-DATA-003)",
        "operationId": "getMarketContext",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by category e.g. eq.Cost of Goods Sold"
          },
          {
            "name": "indicator",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by indicator e.g. eq.Cotton price index"
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by period e.g. eq.2026-06 or in.(2026-04,2026-05,2026-06)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    },
    "/business_rules": {
      "get": {
        "summary": "Fetch business rules and classification logic for financial variance analysis",
        "operationId": "getBusinessRules",
        "parameters": [
          {
            "name": "rule_type",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by rule type e.g. eq.Category_Assign or eq.Variance_Threshold"
          },
          {
            "name": "category_group",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by category group e.g. eq.Revenue or eq.Expense"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of business rules including source metadata",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SupabaseApiKey": {
        "type": "apiKey",
        "name": "apikey",
        "in": "header",
        "description": "Supabase Publishable Key"
      }
    }
  }
}