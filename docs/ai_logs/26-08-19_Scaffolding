"""Load finance line items from a SQL database (see data/schema for DDL)."""

from decimal import Decimal
from typing import Iterator

from finance_assistant.data_access.models import LineItem

LINE_ITEMS_QUERY = """
SELECT period, account, department, actual, plan, currency
FROM line_items
WHERE (%(department)s IS NULL OR department = %(department)s)
  AND (%(period_start)s IS NULL OR period >= %(period_start)s)
  AND (%(period_end)s IS NULL OR period <= %(period_end)s)
"""


def load_line_items(connection, department: str | None = None,
                     period_start: str | None = None,
                     period_end: str | None = None) -> Iterator[LineItem]:
    with connection.cursor() as cursor:
        cursor.execute(
            LINE_ITEMS_QUERY,
            {"department": department, "period_start": period_start, "period_end": period_end},
        )
        columns = [desc[0] for desc in cursor.description]
        for row in cursor.fetchall():
            record = dict(zip(columns, row))
            yield LineItem(
                period=record["period"],
                account=record["account"],
                department=record["department"],
                actual=Decimal(record["actual"]),
                plan=Decimal(record["plan"]) if record["plan"] is not None else None,
                currency=record.get("currency", "USD"),
                source_file="sql:line_items",
            )
