"""Common finance ratio calculations."""

from decimal import Decimal

from finance_assistant.calculations.base import CalculationResult, round_percentage


def gross_margin(revenue: Decimal, cost_of_goods_sold: Decimal) -> CalculationResult:
    if revenue == 0:
        raise ValueError("revenue must be non-zero to compute gross margin")
    value = round_percentage((revenue - cost_of_goods_sold) / revenue * 100)
    return CalculationResult(
        value=value,
        unit="percent",
        method="gross_margin",
        inputs={"revenue": revenue, "cost_of_goods_sold": cost_of_goods_sold},
    )


def operating_margin(operating_income: Decimal, revenue: Decimal) -> CalculationResult:
    if revenue == 0:
        raise ValueError("revenue must be non-zero to compute operating margin")
    value = round_percentage(operating_income / revenue * 100)
    return CalculationResult(
        value=value,
        unit="percent",
        method="operating_margin",
        inputs={"operating_income": operating_income, "revenue": revenue},
    )
