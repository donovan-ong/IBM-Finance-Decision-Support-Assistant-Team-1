"""Simple retrieval over docs/policy for citation-backed answers."""

from dataclasses import dataclass
from pathlib import Path

POLICY_DOCS_DIR = Path(__file__).resolve().parents[3] / "docs" / "policy"


@dataclass(frozen=True)
class PolicyMatch:
    source_file: str
    snippet: str
    score: float


def search(query: str, top_k: int = 3) -> list[PolicyMatch]:
    """Naive keyword search over policy docs. Replace with embeddings-based
    retrieval once the document set is large enough to warrant it."""
    terms = query.lower().split()
    matches: list[PolicyMatch] = []
    for path in POLICY_DOCS_DIR.glob("**/*.md"):
        text = path.read_text(encoding="utf-8")
        lower = text.lower()
        score = sum(lower.count(term) for term in terms)
        if score > 0:
            matches.append(PolicyMatch(source_file=str(path.relative_to(POLICY_DOCS_DIR)), snippet=text[:500], score=score))
    matches.sort(key=lambda m: m.score, reverse=True)
    return matches[:top_k]
