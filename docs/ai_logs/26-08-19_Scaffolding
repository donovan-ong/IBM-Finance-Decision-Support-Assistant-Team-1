"""Shared calculation interfaces, rounding, and units policy."""

from dataclasses import dataclass
from decimal import Decimal, ROUND_HALF_UP
from typing import Protocol


CURRENCY_DECIMAL_PLACES = 2
PERCENTAGE_DECIMAL_PLACES = 1


def round_currency(value: Decimal) -> Decimal:
    return value.quantize(Decimal(10) ** -CURRENCY_DECIMAL_PLACES, rounding=ROUND_HALF_UP)


def round_percentage(value: Decimal) -> Decimal:
    return value.quantize(Decimal(10) ** -PERCENTAGE_DECIMAL_PLACES, rounding=ROUND_HALF_UP)


@dataclass(frozen=True)
class CalculationResult:
    value: Decimal
    unit: str
    method: str
    inputs: dict


class Calculation(Protocol):
    def compute(self, **kwargs) -> CalculationResult: ...
