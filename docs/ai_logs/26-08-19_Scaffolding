"""Actual-vs-plan variance calculations."""

from decimal import Decimal

from finance_assistant.calculations.base import CalculationResult, round_currency, round_percentage


def absolute_variance(actual: Decimal, plan: Decimal) -> CalculationResult:
    value = round_currency(actual - plan)
    return CalculationResult(
        value=value,
        unit="currency",
        method="absolute_variance",
        inputs={"actual": actual, "plan": plan},
    )


def percentage_variance(actual: Decimal, plan: Decimal) -> CalculationResult:
    if plan == 0:
        raise ValueError("plan value must be non-zero to compute percentage variance")
    value = round_percentage((actual - plan) / plan * 100)
    return CalculationResult(
        value=value,
        unit="percent",
        method="percentage_variance",
        inputs={"actual": actual, "plan": plan},
    )
